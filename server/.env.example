# ============================================================
# Bootstrap (MUST stay in the deployment env — required to connect
# to Supabase and to read the vault):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here
PORT=3000

# ============================================================
# Vault-managed secrets (OPTIONAL to set here — the server prefers
# values stored in Supabase Vault, fetched at startup via the
# public.get_secret RPC. These env values are only a fallback).
#
# Store the real values in the Supabase dashboard (Vault) under these
# exact names instead of here:
#   admin_token, r2_account_id, r2_access_key_id,
#   r2_secret_access_key, superwall_webhook_secret,
#   google_translate_api_key, deepgram_api_key
#
# Admin panel protection. The /admin page and /api/admin/* routes require
# this token (login sets an HttpOnly session cookie). Leave unset to
# disable the admin surface entirely (fail-closed).
ADMIN_TOKEN=
# Google Cloud Translation API key (used by the admin "Update Translation &
# Transliteration" button to translate Telugu lyrics into English & Hindi).
# Enable the Cloud Translation API for your project and create the key in
# Google Cloud Console > APIs & Services > Credentials.
GOOGLE_TRANSLATE_API_KEY=
# Deepgram API key, used by the admin "Auto-Sync Lyrics" button to transcribe a
# track's audio and propose lyric timings for review. Prefer storing it in
# Supabase Vault under this exact name (deepgram_api_key); this env value is
# only a fallback. When unset the button fails closed with a clear message --
# nothing partial is ever done.
DEEPGRAM_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public config (not secret):
R2_BUCKET_NAME=soulful-bhakti-music
R2_BASE_URL=https://music.soulfulbhakti.com
SUPERWALL_WEBHOOK_SECRET=
