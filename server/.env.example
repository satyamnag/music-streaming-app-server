SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_service_role_key_here
PORT=3000

# Admin panel protection. The /admin page and /api/admin/* routes require
# this token (login sets an HttpOnly session cookie). Leave unset to
# disable the admin surface entirely (fail-closed).
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Cloudflare R2 (S3-compatible) — used for new music uploads so they stream
# from the CDN. All three are required for R2 uploads; without them the
# admin upload falls back to Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=soulful-bhakti-music
R2_BASE_URL=https://music.soulfulbhakti.com
