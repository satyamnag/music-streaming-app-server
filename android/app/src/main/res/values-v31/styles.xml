<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <!-- The window behind the starting window.
             The platform draws the Android 12 splash over this, but an OEM skin
             that does not honour the windowSplashScreen* attributes still paints
             whatever this is - so it is the SAME black backdrop with the centred
             medallion the pre-12 launch screen uses, and the logo can never be
             missing, white-backed or full-bleed on those devices. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Black, like the reference splash. It was @android:color/transparent,
             which falls back to the LIGHT theme's window background, so on a
             light-themed device the launch showed a white screen with the
             full-bleed icon clipped by the system's circular mask. -->
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <!-- The medallion, drawn at 42% of its canvas ON PURPOSE: the platform
             masks the splash icon to its inner two-thirds (the official
             dimensions are a 288dp icon inside a 192dp visible circle), so
             anything at or beyond 2/3 is sliced off - which is exactly what
             shipped in v96 and what the reported screenshot shows. 42% leaves a
             wide margin on every device and matches the size the legacy launch
             screen draws the same artwork at. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF000000</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Transparent system bars WITHOUT the deprecated colour setters.
             `Window#setStatusBarColor` / `setNavigationBarColor` are deprecated
             for apps targeting 35+ (and no-ops on Android 15), so the app no
             longer calls them - from Kotlin or from Flutter's
             setSystemChromeSystemUIOverlayStyle. With this flag the window draws
             no bar background at all: the status bar and the navigation bar show
             the app's own background, the same look the setters produced, and
             the Flutter root SafeArea keeps content clear of both. -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>
</resources>
