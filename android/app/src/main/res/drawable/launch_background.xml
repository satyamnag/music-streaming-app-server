<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 launch screen, LIGHT variant: white backdrop with the full
     medallion centred at its intrinsic size. The art is transparent PNG, so it
     sits on white without a halo. The night folder keeps the black backdrop, so
     the splash follows the device theme instead of always being dark. -->
<!-- (The bitmap is NOT scaled and NOT masked on these versions, so it is never
     cropped.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash" />
    </item>
</layer-list>
