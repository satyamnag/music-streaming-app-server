<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <!-- OneSignal push notifications (Android 13+ runtime permission) -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- Setting a ringtone/notification/alarm sound requires the user to grant
       "modify system settings" via Settings.ACTION_MANAGE_WRITE_SETTINGS.
       This is a special permission, not a runtime prompt. -->
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />

  <!-- ADVERTISING ID.
       Play Console: App content -> Advertising ID -> "Yes", because Google
       Analytics for Firebase (declared in android/app/build.gradle) reads the
       advertising ID for measurement and attribution when analytics is on.

       It is declared EXPLICITLY rather than left to the manifest merger: Play
       blocks a release whose declaration says "Yes" while the artifact lacks
       this permission, so it must not be possible for a dependency change to
       remove it silently. test/play_advertising_id_test.dart and the release
       workflow's permission audit both fail if it disappears.

       The identifier is never used for personalized advertising (see the
       google_analytics_default_allow_ad_personalization_signals meta-data
       below) and never while analytics is off. -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

  <queries>
    <!-- If your app opens https URLs -->
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <application
    android:name="com.sangeet.app.SoulfulBhaktiApp"
    android:allowBackup="false"
    android:fullBackupContent="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name_en"
    android:requestLegacyExternalStorage="true"
    android:usesCleartextTraffic="true">
    <!-- Enable Impeller -->
    <!-- <meta-data
      android:name="io.flutter.embedding.android.EnableImpeller"
      android:value="false" /> -->

    <!-- Analytics consent. Product analytics is opt-in in this app (Settings ->
         Privacy -> Share analytics), and these two flags make the SDKs honour
         that decision from the very first launch:

         * firebase_analytics_collection_enabled=false disables Google Analytics
           for Firebase collection until the listener turns analytics on; the
           app re-enables it with FirebaseAnalytics.setAnalyticsCollectionEnabled
           (lib/services/analytics/firebase_analytics_service.dart). This is the
           documented mechanism for "get end-user consent before collecting data":
           https://firebase.google.com/docs/analytics/android/configure-data-collection

         * google_analytics_default_allow_ad_personalization_signals=false keeps
           the advertising identifier OUT of personalized advertising: it is used
           for measurement/analytics only, which is what the privacy policy and
           the Play Ads policy promise. The identifier itself is still collected
           when analytics is on - which is what the Console "Yes" declares. -->
    <meta-data
      android:name="firebase_analytics_collection_enabled"
      android:value="false" />
    <meta-data
      android:name="google_analytics_default_allow_ad_personalization_signals"
      android:value="false" />

    <activity
      android:name="com.sangeet.app.MainActivity"
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
      android:exported="true"
      android:hardwareAccelerated="true"
      android:launchMode="singleInstance"
      android:theme="@style/LaunchTheme"
      android:windowSoftInputMode="adjustResize">
      <!--
              Specifies an Android theme to apply to this Activity as soon as
              the Android process has started. This theme is visible to the user
              while the Flutter UI initializes. After that, this theme continues
              to determine the Window background behind the Flutter UI.
            -->
      <meta-data
        android:name="io.flutter.embedding.android.NormalTheme"
        android:resource="@style/NormalTheme" />

      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
      </intent-filter>

      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/*" />
      </intent-filter>

      <intent-filter>
        <action android:name="android.intent.action.VIEW" />

        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="sangeet" />
      </intent-filter>

      <intent-filter>
        <action android:name="es.antonborri.home_widget.action.LAUNCH" />
      </intent-filter>
    </activity>

    <!-- AudioService Config -->
    <service
      android:name="com.ryanheise.audioservice.AudioService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>
    <receiver
      android:name="com.ryanheise.audioservice.MediaButtonReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </receiver>
    <!-- =================== -->

    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />

    <!--  Home Widget config  -->
    <receiver
      android:name=".glance.HomePlayerWidgetReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/home_player_widget_config" />
    </receiver>

    <receiver
      android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
      </intent-filter>
    </receiver>

    <service
      android:name="es.antonborri.home_widget.HomeWidgetBackgroundService"
      android:exported="true"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <!-- =================== -->

    <!-- Don't delete the meta-data below.
                 This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
    <meta-data
      android:name="flutterEmbedding"
      android:value="2" />

    <!-- PostHog: manual initialisation only.
         AUTO_INIT=false stops the native SDK from starting itself from manifest
         values, which is what lets the app decide at runtime whether to start it
         at all. The project token is NOT in this file: it is injected through
         .env (POSTHOG_API_KEY) and applied in
         lib/services/analytics/posthog_service.dart, which calls setup() only
         after the user has opted in to analytics. -->
    <meta-data
      android:name="com.posthog.posthog.AUTO_INIT"
      android:value="false" />
  </application>
</manifest>