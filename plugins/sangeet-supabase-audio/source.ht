class SupabaseAudioSource {
  var audioSource
  var browse
  var search
  var track
  var album
  var artist
  var playlist
  var user
  var auth
  var core

  construct {
    var baseUrl = "https://music-streaming-app-server.onrender.com"
    audioSource = SupabaseAudioSourceImpl(baseUrl)
    browse = SupabaseBrowseEndpoint(baseUrl)
    search = SupabaseSearchEndpoint(baseUrl)
    track = SupabaseTrackEndpoint(baseUrl)
    album = SupabaseAlbumEndpoint(baseUrl)
    artist = SupabaseArtistEndpoint(baseUrl)
    playlist = SupabasePlaylistEndpoint(baseUrl)
    user = SupabaseUserEndpoint(baseUrl)
    auth = SupabaseAuthEndpoint()
    core = SupabaseCoreEndpoint()
  }
}

export { SupabaseAudioSource }
