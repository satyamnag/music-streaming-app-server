class SupabasePlaylistEndpoint {
  var _baseUrl

  construct(baseUrl) {
    _baseUrl = baseUrl
  }

  fun getPlaylist(id) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/playlists/" + id).then((response) {
      if (response.statusCode != 200) {
        return null
      }
      return response.data
    })
  }

  fun tracks(id, {offset, limit}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/playlists/" + id + "/tracks").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return response.data
    })
  }

  fun create(userId, {name, description, public, collaborative}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/api/playlists", queryParameters: struct { "q": "create" }).then((response) {
      if (response.statusCode != 200) {
        return null
      }
      return response.data
    })
  }

  fun update(playlistId, {name, description, public, collaborative}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    client.get_req("/api/playlists/" + playlistId).then((response) {
    })
  }

  fun addTracks(playlistId, {trackIds, position}) {
    if (trackIds != null && trackIds.length > 0) {
      var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
      client.get_req("/api/playlists/" + playlistId + "/songs", queryParameters: struct { "track_id": trackIds[0] }).then((response) {
      })
    }
  }

  fun removeTracks(playlistId, {trackIds}) {
    if (trackIds != null && trackIds.length > 0) {
      var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
      client.get_req("/api/playlists/" + playlistId + "/songs/" + trackIds[0]).then((response) {
      })
    }
  }

  fun save(playlistId) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    client.get_req("/api/playlists/" + playlistId).then((response) {
    })
  }

  fun unsave(playlistId) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    client.get_req("/api/playlists/" + playlistId).then((response) {
    })
  }

  fun deletePlaylist(playlistId) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    client.get_req("/api/playlists/" + playlistId).then((response) {
    })
  }
}

class SupabaseUserEndpoint {
  var _baseUrl

  construct(baseUrl) {
    _baseUrl = baseUrl
  }

  fun me() {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/users/me").then((response) {
      if (response.statusCode != 200) {
        return struct { "id": "", "name": "", "images": [], "externalUri": "" }
      }
      return response.data
    })
  }

  fun savedTracks({offset, limit}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/liked-songs/supabase").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return struct { "items": response.data, "limit": 20, "nextOffset": null, "total": response.data.length, "hasMore": false }
    })
  }

  fun savedPlaylists({offset, limit}) {
    return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
  }

  fun savedAlbums({offset, limit}) {
    return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
  }

  fun savedArtists({offset, limit}) {
    return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
  }

  fun isSavedPlaylist(playlistId) {
    return false
  }

  fun isSavedTracks(ids) {
    var result = []
    for (var i = 0; i < ids.length; i++) {
      result.add(false)
    }
    return result
  }

  fun isSavedAlbums(ids) {
    var result = []
    for (var i = 0; i < ids.length; i++) {
      result.add(false)
    }
    return result
  }

  fun isSavedArtists(ids) {
    var result = []
    for (var i = 0; i < ids.length; i++) {
      result.add(false)
    }
    return result
  }
}

