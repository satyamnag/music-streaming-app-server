import "module:std" as std
var HttpClient = std.HttpClient
var HttpBaseOptions = std.HttpBaseOptions
var HttpResponse = std.HttpResponse

class SupabaseAudioSourceImpl {
  var _baseUrl

  construct (baseUrl) {
    _baseUrl = baseUrl
  }

  get supportedPresets {
    return [
      struct { "type": "lossy", "name": "mp3", "qualities": [struct { "bitrate": 128000 }] },
      struct { "type": "lossy", "name": "opus", "qualities": [struct { "bitrate": 96000 }] }
    ]
  }

  fun matches(trackJson) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 15000, receiveTimeout: 30000))
    return client.get_req("/search?q=" + trackJson["name"]).then((response) {
      if (response.statusCode != 200) {
        return []
      }
      return response.data
    })
  }

  fun streams(matchJson) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/stream/" + matchJson["id"]).then((response) {
      if (response.statusCode != 200) {
        return []
      }
      return [response.data]
    })
  }
}

class SupabaseBrowseEndpoint {
  var _baseUrl

  construct(baseUrl) {
    _baseUrl = baseUrl
  }

  fun sections({offset, limit}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/browse/sections").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return response.data
    })
  }

  fun sectionItems(id, {offset, limit}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/browse/sections/" + id + "/items").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return response.data
    })
  }
}

class SupabaseSearchEndpoint {
  var _baseUrl

  construct(baseUrl) {
    _baseUrl = baseUrl
  }

  get chips {
    return ["Supabase Songs"]
  }

  fun all(query) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/search?q=" + query + "&all=true").then((response) {
      if (response.statusCode != 200) {
        return struct { "tracks": [], "albums": [], "artists": [], "playlists": [] }
      }
      return response.data
    })
  }

  fun albums(query, {limit, offset}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/search?q=" + query + "&albums=true").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
    })
  }

  fun artists(query, {limit, offset}) {
    return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
  }

  fun playlists(query, {limit, offset}) {
    return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
  }

  fun tracks(query, {limit, offset}) {
    var client = HttpClient(HttpBaseOptions(baseUrl: _baseUrl, connectTimeout: 10000, receiveTimeout: 30000))
    return client.get_req("/search?q=" + query + "&tracks=true").then((response) {
      if (response.statusCode != 200) {
        return struct { "items": [], "limit": 20, "nextOffset": null, "total": 0, "hasMore": false }
      }
      return struct { "items": response.data, "limit": 20, "nextOffset": null, "total": response.data.length, "hasMore": false }
    })
  }
}

